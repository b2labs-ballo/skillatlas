# Copy this file to ".env.local" and fill in the values.
# ".env.local" is never uploaded to GitHub - keep your keys only there.

# GitHub token (read-only access to public data is enough)
GITHUB_TOKEN=

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key - used only by the ingestion job, never by the website
SUPABASE_SERVICE_ROLE_KEY=
